# Banco (Supabase/Postgres)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Supabase
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SECRET_KEY=""

# Sessão (login persistente)
# O refresh token fica num cookie HttpOnly com validade deslizante de 400 dias.
# - Front e API no mesmo site (ex.: app.dominio.com + api.dominio.com, ou localhost):
#   não precisa configurar nada (SameSite=Lax).
# - Front e API em sites diferentes (ex.: *.vercel.app + *.onrender.com):
#   AUTH_COOKIE_SAMESITE=none e FRONTEND_ORIGINS obrigatório (exige HTTPS).
# FRONTEND_ORIGINS="https://app.seudominio.com"   # origens autorizadas no CORS (separadas por vírgula)
# AUTH_COOKIE_SAMESITE=lax                        # lax | strict | none
# AUTH_COOKIE_SECURE=true                         # padrão: true em NODE_ENV=production
# AUTH_COOKIE_DOMAIN=.seudominio.com              # opcional: compartilhar entre subdomínios

# Geocoding
GEOAPIFY_API_KEY=""

# Assistente IA (OpenAI) — a chave fica SOMENTE no backend
OPENAI_API_KEY=""
# Modelo econômico com suporte a Structured Outputs na Responses API
OPENAI_MODEL="gpt-5.4-mini"

# Opcionais (valores padrão entre parênteses)
# OPENAI_TIMEOUT_MS=20000          (tempo máximo por chamada)
# OPENAI_MAX_OUTPUT_TOKENS=2000    (limite de tokens de saída)
# OPENAI_REASONING_EFFORT=low      (none|minimal|low|medium; vazio = padrão do modelo)
# ASSISTENTE_LIMITE_POR_MINUTO=12  (mensagens por usuário por minuto)
# ASSISTENTE_LIMITE_POR_HORA=150   (mensagens por usuário por hora)
